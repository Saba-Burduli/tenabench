{
  "name": "tenabench",
  "version": "1.0.0",
  "private": true,
  "description": "Real-World Agent Capability Lab — benchmark for AI engineering agents",
  "scripts": {
    "build": "tsc --build",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "start": "ts-node apps/api/src/server.ts",
    "benchmark": "ts-node benchmark/runner.ts",
